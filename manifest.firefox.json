{
  "manifest_version": 3,
  "name": "Tabula",
  "version": "1.6.0",
  "description": "Customizable spreadsheet-style speed-dial new tab page with sheets, themes, and a Bing daily image option.",
  "browser_specific_settings": {
    "gecko": {
      "id": "tabula@withersky.local",
      "strict_min_version": "109.0"
    }
  },
  "chrome_url_overrides": {
    "newtab": "newtab.html"
  },
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://www.bing.com/*",
    "https://www.google.com/*",
    "https://api.met.no/*",
    "https://geocoding-api.open-meteo.com/*"
  ],
  "background": {
    "scripts": ["lib/browser.js", "background.js"],
    "persistent": false
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Tabula — open options",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "author": "withersky",
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  }
}
