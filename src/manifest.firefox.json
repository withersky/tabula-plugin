{
  "manifest_version": 3,
  "name": "Tabula",
  "version": "2.8.16",
  "description": "Customizable spreadsheet-style speed-dial new tab page with sheets, themes, and a Bing daily image option.",
"browser_specific_settings": {
"gecko": {
"id": "tabula@withersky.local",
"strict_min_version": "140.0",
"update_url": "https://tabula.withersky.workers.dev/updates.json",
"data_collection_permissions": {
"required": ["none"]
}
},
"gecko_android": {
"strict_min_version": "142.0"
}
},
  "chrome_url_overrides": {
    "newtab": "newtab/newtab.html"
  },
  "permissions": [
    "storage",
    "bookmarks"
  ],
  "host_permissions": [
    "https://www.bing.com/*",
    "https://www.google.com/*",
    "https://api.met.no/*",
    "https://geocoding-api.open-meteo.com/*",
    "https://suggestqueries.google.com/*",
    "https://suggest.yandex.ru/*",
    "https://api.bing.com/*"
  ],
  "background": {
    "scripts": [
      "lib/browser.js",
      "i18n/generated/symbols.js",
      "lib/core.js",
      "lib/timezone.js",
      "background.js"
    ]
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Tabula — new tab",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "author": "withersky",
  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": true
  }
}
